++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
Windows Audit & Logging Setup Script
This batch script configures detailed Windows audit policies and enables advanced logging for Domain Controllers and servers. It activates key audit categories, Windows Remote Management (WinRM), WMI logging, and PowerShell script/block/module logging to improve security monitoring and incident response.
Run with admin privileges to quickly harden Windows hosts and enhance visibility into critical security events.
++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++







@echo off

REM =============================
REM Windows Audit Policy Baseline + WinRM, WMI, and PowerShell Logging
REM =============================

REM ---- WinRM setup ----
REM Enable and configure Windows Remote Management service
sc config WinRM start= auto
net start WinRM
wevtutil set-log "Microsoft-Windows-WinRM/Operational" /enabled:true

REM ---- WMI logging setup ----
REM Enable WMI Activity logging and force WMI to emit events
wevtutil set-log "Microsoft-Windows-WMI-Activity/Operational" /enabled:true
reg add "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Winmgmt\\Parameters" /v EnableEvents /t REG_DWORD /d 1 /f
net stop winmgmt /y
net start winmgmt

REM ---- PowerShell logging ----
REM Enable logging for PowerShell script blocks, modules, and transcripts
reg add "HKLM\\Software\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging" /v EnableScriptBlockLogging /t REG_DWORD /d 1 /f
reg add "HKLM\\Software\\Policies\\Microsoft\\Windows\\PowerShell\\ModuleLogging" /v EnableModuleLogging /t REG_DWORD /d 1 /f
reg add "HKLM\\Software\\Policies\\Microsoft\\Windows\\PowerShell\\ModuleLogging\\ModuleNames" /v * /t REG_SZ /d * /f
reg add "HKLM\\Software\\Policies\\Microsoft\\Windows\\PowerShell\\Transcription" /v EnableTranscripting /t REG_DWORD /d 1 /f
reg add "HKLM\\Software\\Policies\\Microsoft\\Windows\\PowerShell\\Transcription" /v OutputDirectory /t REG_SZ /d "C:\\PowerShellLogs" /f

REM ---- Audit Policies ----
REM Apply detailed audit policy settings

REM System Integrity: monitors file and system integrity changes
auditpol /set /subcategory:"System Integrity" /success:enable /failure:enable
REM Security System Extension: logs security subsystem extensions
auditpol /set /subcategory:"Security System Extension" /success:enable /failure:enable
REM Other System Events: captures miscellaneous system-level events
auditpol /set /subcategory:"Other System Events" /success:enable /failure:enable
REM Security State Change: tracks system startup, shutdown, reboot
auditpol /set /subcategory:"Security State Change" /success:enable

REM Logon: tracks logon/logoff attempts
auditpol /set /subcategory:"Logon" /success:enable /failure:enable
REM Logoff: logs successful logoffs
auditpol /set /subcategory:"Logoff" /success:enable
REM Account Lockout: logs when accounts are locked
auditpol /set /subcategory:"Account Lockout" /success:enable
REM Special Logon: logs usage of privileged accounts
auditpol /set /subcategory:"Special Logon" /success:enable
REM Network Policy Server: logs NPS/RADIUS authentications
auditpol /set /subcategory:"Network Policy Server" /success:enable /failure:enable

REM Removable Storage: logs access to removable devices
auditpol /set /subcategory:"Removable Storage" /success:enable /failure:enable

REM Sensitive Privilege Use: logs use of sensitive privileges
auditpol /set /subcategory:"Sensitive Privilege Use" /success:enable /failure:enable

REM Process Creation: logs process start
auditpol /set /subcategory:"Process Creation" /success:enable
REM Process Termination: logs process stop
auditpol /set /subcategory:"Process Termination" /success:enable

REM Audit Policy Change: logs changes to audit policy
auditpol /set /subcategory:"Audit Policy Change" /success:enable
REM Authentication Policy Change: logs changes to authentication policy
auditpol /set /subcategory:"Authentication Policy Change" /success:enable

REM User Account Management: tracks changes to user accounts
auditpol /set /subcategory:"User Account Management" /success:enable /failure:enable
REM Security Group Management: tracks changes to groups
auditpol /set /subcategory:"Security Group Management" /success:enable /failure:enable
REM Computer Account Management: tracks changes to computer accounts
auditpol /set /subcategory:"Computer Account Management" /success:enable /failure:enable

REM Directory Service Access: logs AD object access
auditpol /set /subcategory:"Directory Service Access" /success:enable /failure:enable
REM Directory Service Changes: logs AD modifications
auditpol /set /subcategory:"Directory Service Changes" /success:enable /failure:enable
REM Directory Service Replication: logs AD replication
auditpol /set /subcategory:"Directory Service Replication" /success:enable /failure:enable

REM Credential Validation: logs credential validation attempts
auditpol /set /subcategory:"Credential Validation" /success:enable /failure:enable

REM Kerberos Authentication Service: logs Kerberos ticket granting
auditpol /set /subcategory:"Kerberos Authentication Service" /success:enable /failure:enable
REM Kerberos Service Ticket Operations: logs Kerberos ticket usage
auditpol /set /subcategory:"Kerberos Service Ticket Operations" /success:enable /failure:enable

echo All auditing, WinRM, WMI, and PowerShell logging are now enabled.
pause
